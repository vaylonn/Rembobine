# Copier en .env puis remplir (chmod 600 .env). Ne JAMAIS versionner .env.

# Utilisateur propriétaire des fichiers (commande `id` sur le Pi)
PUID=1000
PGID=1000
TZ=Europe/Paris

# Dossiers
CONFIG_ROOT=/home/val/houseflix/config
DATA_ROOT=/mnt/media/data

# Réseau local de la box
LAN_SUBNET=192.168.1.0/24

# Mullvad WireGuard : https://mullvad.net/fr/account/wireguard-config (Linux)
#   PrivateKey -> WIREGUARD_PRIVATE_KEY
#   Address (partie IPv4, ex. 10.x.x.x/32) -> WIREGUARD_ADDRESSES
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_COUNTRIES=Switzerland
# Serveurs épinglés (ceux qui répondent de façon fiable depuis ta connexion)
VPN_HOSTNAMES=ch-zrh-wg-202,ch-zrh-wg-502
