# Jeton "API Read Access Token" (v4) de TMDB : https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Chaîne de connexion Postgres (Neon via Vercel Marketplace, ou tout autre Postgres)
DATABASE_URL=

# Mot de passe pour accéder à l'app (un seul utilisateur : toi)
APP_PASSWORD=

# Secret de signature des sessions, au moins 32 caractères aléatoires
# (ex. : openssl rand -base64 32)
SESSION_SECRET=
